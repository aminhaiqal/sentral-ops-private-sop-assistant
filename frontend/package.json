{
  "name": "sentral-ops-private-sop-assistant-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src tests index.html vite.config.ts *.json .prettierrc.json",
    "format:check": "prettier --check src tests index.html vite.config.ts *.json .prettierrc.json",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test:browser": "node --test tests/browser/*.test.mjs"
  },
  "dependencies": {
    "@clerk/react": "^6.18.6",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "playwright": "^1.65.0",
    "prettier": "^3.6.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
