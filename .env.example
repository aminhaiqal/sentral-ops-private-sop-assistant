OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=none
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=sentral_ops_sops
MIN_SOURCE_SCORE=0.22
MAX_CONTEXT_SOURCES=5
AUTO_INGEST_ON_STARTUP=true

BACKEND_CORS_ORIGINS=http://localhost:5173
# Leave empty to use the frontend's /api proxy in both development and Docker.
VITE_API_URL=

# Private Cloudflare R2 bucket. Credentials stay on the backend.
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PREFIX=sentral-ops
WORKSPACE_COOKIE_SECURE=false

# HTTPS deployment only: set a hostname without a scheme or path.
# APP_DOMAIN=assistant.example.com
# SENTRAL_RELEASE=latest
