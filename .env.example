OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=none
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=sentral_ops_sops
MIN_SOURCE_SCORE=0.22

# Autopilot harness. Defaults work for native development; Compose uses /app/var.
# HARNESS_DB_PATH=/absolute/path/to/harness.sqlite3
HARNESS_MAX_TURNS=16
HARNESS_MAX_TOKENS=32000
HARNESS_MAX_CONTEXT_CHARS=200000
HARNESS_MAX_RUNTIME_SECONDS=600
HARNESS_REQUEST_TIMEOUT_SECONDS=60

BACKEND_CORS_ORIGINS=http://localhost:5173
# Clerk publishable key and Frontend API origin from the same Clerk application.
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_ISSUER_URL=
# Defaults to BACKEND_CORS_ORIGINS when empty.
CLERK_AUTHORIZED_PARTIES=
# Optional PEM public verification key. Otherwise keys are fetched from Clerk's JWKS.
CLERK_JWT_KEY=
CLERK_AUDIENCE=
# Leave empty to use the frontend's /api proxy in both development and Docker.
VITE_API_URL=

# Private Cloudflare R2 bucket. Credentials stay on the backend.
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PREFIX=sentral-ops

# HTTPS deployment only: set a hostname without a scheme or path.
# APP_DOMAIN=assistant.example.com
# SENTRAL_RELEASE=latest
